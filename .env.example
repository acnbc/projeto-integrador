# Desenvolvimento local
ENV=dev
# Com Docker Compose (porta 3307 no host):
DATABASE_URL=mysql+pymysql://admin:admin@127.0.0.1:3307/ufrj
# Com MySQL local na porta padrão:
# DATABASE_URL=mysql+pymysql://admin:admin@127.0.0.1:3306/ufrj
SECRET_KEY=troque-esta-chave-em-producao-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_ECHO=false

# Docker Compose (app usa db como host)
# DATABASE_URL=mysql+pymysql://admin:admin@db:3306/ufrj

# Nuvem (Render, Railway, Fly.io, etc.)
# ENV=production
# PORT=8000
# DATABASE_URL=<URL do MySQL gerenciado na nuvem>
